generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  PAID
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELLED
}

enum StoreCategory {
  FASHION
  FOOD
  ELECTRONICS
  BEAUTY
  HOME
  BOOKS
  SPORTS
  GENERAL
}

enum PaymentMethod {
  PAYSTACK
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
}

model Merchant {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String   @unique
  phone       String?
  role        Role     @default(USER)
  store       Store?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Store {
  id          String        @id @default(cuid())
  merchantId  String        @unique
  merchant    Merchant      @relation(fields: [merchantId], references: [id])
  name        String
  slug        String        @unique
  description String?
  logoUrl     String?
  primaryColor String       @default("#18181B")
  accentColor  String       @default("#F4F4F5")
  heroStyle   String        @default("auto") // "auto" = seeded pick; later: pinned family or "image"
  category    StoreCategory @default(GENERAL)

  // Country-neutral seams (Nigeria defaults)
  country  String @default("NG")
  currency String @default("NGN")

  // Model B — Paystack subaccount + bank. No per-merchant secret keys.
  paystackSubaccountCode String?
  bankCode               String?
  bankAccountNumber      String?
  bankAccountName        String?

  platformFeePercent Float @default(3.0)

  paystackEnabled Boolean @default(false)
  codEnabled      Boolean @default(true)
  deliveryFee     Int     @default(0)

  // Billing
  plan                 Plan               @default(FREE)
  subscriptionStatus   SubscriptionStatus @default(ACTIVE)
  subscriptionRenewsAt DateTime?

  onboardingComplete Boolean @default(false)
  isSuspended        Boolean @default(false)

  products  Product[]
  orders    Order[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id           String           @id @default(cuid())
  storeId      String
  store        Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  price        Int
  comparePrice Int?
  images       String[]
  sku          String?
  stock        Int              @default(0)
  trackStock   Boolean          @default(true)
  isVisible    Boolean          @default(true)
  codEnabled   Boolean          @default(true)
  category     String?
  tags         String[]
  variantAttributes ProductVariantAttribute[]
  variantCombos     ProductVariantCombo[]
  orderItems   OrderItem[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([storeId])
}

model ProductVariantAttribute {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String        // "Size"
  values    String[]      // ["S","M","L"]
  position  Int      @default(0)

  @@index([productId])
}

model ProductVariantCombo {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  options   Json          // {"Size":"M","Color":"Blue"}
  price     Int?          // null = inherit Product.price
  stock     Int      @default(0)   // 0 = out of stock for this combo (enforced only when Product.trackStock)
  image     String?       // one of Product.images, or null = inherit Product.images[0]

  @@index([productId])
}

model Order {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  reference String @unique @default(cuid())

  // Guest buyer — captured at checkout, not an account
  customerName    String
  customerEmail   String
  customerPhone   String
  deliveryAddress String
  deliveryCity    String
  deliveryState   String

  items       OrderItem[]
  subtotal    Int
  deliveryFee Int         @default(0)
  platformFee Int         @default(0)
  total       Int

  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus     @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(PENDING)

  paystackRef String?
  notes       String?

  deliveredAt              DateTime?
  deliveryConfirmedByBuyer Boolean   @default(false)
  trackingNumber           String?
  logisticsProvider        String?   @default("self")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@index([reference])
}

model OrderItem {
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product  Product @relation(fields: [productId], references: [id])

  productName  String
  productImage String?
  quantity     Int
  unitPrice    Int
  selectedVariants Json?
}
